APP_NAME="Jeffries Mechanicals"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jeffries Mechanicals
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@jeffriesmechanicals.com
ADMIN_PASSWORD=
ADMIN_NOTIFICATION_MAIL=false
COMPANY_PHONE=
COMPANY_EMAIL=
REVALIDATE_SECRET=
# TRUSTED_PROXIES=

# ---------------------------------------------------------------
# PRODUCTION CHECKLIST — override these on the server:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://admin.your-domain.com
#   FRONTEND_URL=https://your-domain.com
#   CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#   DB_CONNECTION=mysql (or pgsql) + credentials
#   SESSION_SECURE_COOKIE=true
#   SESSION_ENCRYPT=true
#   MAIL_MAILER=smtp (+ credentials) and ADMIN_NOTIFICATION_MAIL=true if email alerts wanted
#   ADMIN_EMAIL / ADMIN_PASSWORD — a NEW strong password; remove ADMIN_PASSWORD after seeding
#   TRUSTED_PROXIES=<load balancer IPs> when behind a proxy
# ---------------------------------------------------------------
