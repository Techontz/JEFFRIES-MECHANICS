# Jeffries Mechanicals backend: production settings for GoDaddy cPanel.
# On the server: copy this file to .env in ~/jeffries-backend, then fill in every CHANGE-ME.
# Never commit the filled-in .env.

APP_NAME="Jeffries Mechanicals"
APP_ENV=production
# Generated on the server with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.jeffriesmechanicals.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel > MySQL Database Wizard. cPanel prefixes names with your account user, e.g. abc123_jeffries.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Shared hosting has no queue worker; run jobs immediately.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# The website(s) allowed to send forms to this API.
FRONTEND_URL=https://jeffriesmechanicals.com
CORS_ALLOWED_ORIGINS=https://jeffriesmechanicals.com,https://www.jeffriesmechanicals.com,https://jeffries-mechanics.vercel.app

# First admin login for https://api.jeffriesmechanicals.com/admin (used once by db:seed).
ADMIN_EMAIL=admin@jeffriesmechanicals.com
ADMIN_PASSWORD=CHANGE-ME

# Email alerts for new submissions. Leave false until SMTP below is filled in;
# submissions always appear in the admin panel either way.
ADMIN_NOTIFICATION_MAIL=false
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS="info@jeffriesmechanicals.com"
MAIL_FROM_NAME="${APP_NAME}"

COMPANY_PHONE="1 (888) 301-2511"
COMPANY_EMAIL=info@jeffriesmechanicals.com

# Not used on static hosting (pages load live data in the browser).
REVALIDATE_SECRET=
